<?xml version="1.0" encoding="utf-8"?>
<!-- atajos al mantener apretado el ícono de Petalwave -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="recognize" android:enabled="true" android:icon="@drawable/ic_note"
        android:shortcutShortLabel="@string/sc_recog" android:shortcutLongLabel="@string/sc_recog_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.petalwave.app" android:targetClass="com.petalwave.app.MainActivity">
            <extra android:name="pw_go" android:value="recognize" />
        </intent>
    </shortcut>
